<?xml version="1.0" encoding="utf-8"?>
<!-- 2×1: the dial · the timer (or "not on shift") · amount and rate in one short line -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:clipToOutline="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="14dp">
        <ImageView android:id="@+id/w_dial" android:layout_width="56dp" android:layout_height="56dp"
            android:contentDescription="@string/etzba_widget_dial" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="10dp" android:orientation="vertical">
            <Chronometer android:id="@+id/w_timer" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:includeFontPadding="false" android:textColor="#FFF2EDE4" android:textSize="21sp" android:fontFamily="sans-serif-light" />
            <TextView android:id="@+id/w_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end" android:textColor="#FFF2EDE4" android:textSize="15sp" android:textStyle="bold" android:visibility="gone" />
            <TextView android:id="@+id/w_line" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="3dp" android:maxLines="1" android:ellipsize="end" android:textColor="#FF9C978E" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
