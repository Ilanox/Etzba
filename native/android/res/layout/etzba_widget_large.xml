<?xml version="1.0" encoding="utf-8"?>
<!-- expanded (4×2): brand and status · a big timer · pay so far and rate · a full-width button -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="16dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/w_mark" android:layout_width="20dp" android:layout_height="20dp"
            android:src="@drawable/ic_stat_etzba" android:contentDescription="@null" />
        <TextView android:id="@+id/w_job" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="8dp" android:maxLines="1" android:ellipsize="end"
            android:textColor="#FFB5AFA3" android:textSize="13sp" android:fontFamily="sans-serif-medium" />
        <ImageView android:id="@+id/w_dot" android:layout_width="7dp" android:layout_height="7dp" android:layout_marginEnd="6dp"
            android:src="@drawable/widget_dot" android:contentDescription="@null" android:visibility="gone" />
        <TextView android:id="@+id/w_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:maxLines="1" android:textColor="#FFB5AFA3" android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center_vertical" android:orientation="vertical">
        <Chronometer android:id="@+id/w_timer" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFEFEAE0" android:textSize="34sp" android:fontFamily="sans-serif-medium" android:visibility="gone" />
        <TextView android:id="@+id/w_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end" android:textColor="#FFEFEAE0" android:textSize="24sp" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/w_pay" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end" android:textColor="#FFFF6A3D" android:textSize="15sp" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/w_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end" android:textColor="#FFB5AFA3" android:textSize="13sp" />
    </LinearLayout>

    <TextView android:id="@+id/w_btn" android:layout_width="match_parent" android:layout_height="42dp"
        android:background="@drawable/widget_btn" android:gravity="center" android:maxLines="1"
        android:textColor="#FFFFFFFF" android:textSize="15sp" android:fontFamily="sans-serif-medium" />
</LinearLayout>
